<xml>
	<set name="PROJECT_DIR" value="${this_dir}" />

	<files id='haxe'>
		<compilervalue name="-I" value="${PROJECT_DIR}/" />
		<compilervalue name="-I" value="${PROJECT_DIR}/include" />
	</files>

	<target id='haxe' tool='linker' toolid='exe'>
		<!--
		CRT-mismatch LNK4098/LNK4217/LNK4286 indicates prebuilt libs were compiled
		different from hxcpp's selected runtime.
		Temporary: don't link the prebuilt opus/ogg/opusfile libs so the
		application can link.

		If you need audio codecs, rebuild libogg/opus/opusfile with the same MSVC CRT
		as the hxcpp/OpenFL build (typically /MD for release, /MDd for debug).
		-->
		<!-- Opus disabled for now (prebuilt libopus/libopusfile not linked).
		     Fixes current Windows link errors (unresolved op_* symbols). -->


	</target>
</xml>